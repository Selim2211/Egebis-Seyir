// Veri modeli (ADR-009). Kural: workspace'e ait her model `workspaceId` taşır (ADR-012)
// ve TENANT_MODELS listesine eklenir (src/infra/prisma/tenant-scope.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  WORKSPACE
  SPACE
}

enum EstimationScale {
  FIBONACCI
  TSHIRT
  NUMBER
}

enum StatusCategory {
  NOT_STARTED
  ACTIVE
  DONE
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  SUBTASK
  BUG
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum BugSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TshirtSize {
  S
  M
  L
  XL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SprintItemAction {
  ADDED
  REMOVED
}

enum SprintItemReason {
  PLANNED
  SCOPE_CHANGE
  CARRIED_OVER
  /// Sprint tamamlanırken/iptal edilirken bitmemiş olarak çıkarıldı.
  UNFINISHED
}

enum ChecklistKind {
  ACCEPTANCE
  CHECKLIST
}

enum LinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum FavoriteType {
  SPACE
  FOLDER
  LIST
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Küçük harfe çevrilmiş e-posta.
  email         String   @unique
  name          String
  /// argon2id, PHC biçimi (ADR-038).
  passwordHash  String
  title         String?
  locale        String   @default("tr")
  theme         String   @default("system")
  timezone      String   @default("Europe/Istanbul")
  /// Profil fotoğrafı sürümü (önbellek anahtarı); null = fotoğraf yok (ADR-059).
  avatarVersion String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  sessions         Session[]
  memberships      Membership[]
  passwordResets   PasswordResetToken[]
  invitationsSent  Invitation[]         @relation("InvitedBy")
  activities       ActivityEvent[]
  spaceMembers     SpaceMember[]
  favorites        Favorite[]
  reportedItems    WorkItem[]           @relation("Reporter")
  assignedItems    WorkItemAssignee[]
  watchedItems     WorkItemWatcher[]
  comments         Comment[]
  commentMentions  CommentMention[]
  commentReactions CommentReaction[]
  attachments      Attachment[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256(token); token yalnızca cookie'de.
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  roles             Role[]
  memberships       Membership[]
  invitations       Invitation[]
  activities        ActivityEvent[]
  spaces            Space[]
  spaceKeys         SpaceKey[]
  spaceMembers      SpaceMember[]
  statuses          Status[]
  folders           Folder[]
  lists             List[]
  favorites         Favorite[]
  workItems         WorkItem[]
  workItemAssignees WorkItemAssignee[]
  labels            Label[]
  workItemLabels    WorkItemLabel[]
  checklists        Checklist[]
  checklistItems    ChecklistItem[]
  workItemLinks     WorkItemLink[]
  workItemWatchers  WorkItemWatcher[]
  comments          Comment[]
  commentMentions   CommentMention[]
  commentReactions  CommentReaction[]
  attachments       Attachment[]
  sprints           Sprint[]
  sprintItemEvents  SprintItemEvent[]

  @@map("workspaces")
}

/// Rol = izin seti (ADR-011). Sistem rolleri workspace oluşturulurken shared varsayılanlarından kopyalanır.
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope       RoleScope
  /// Sistem rolleri için WORKSPACE_ROLES / SPACE_ROLES anahtarı.
  key         String
  /// Özel roller (F2) için görünen ad; sistem rollerinin adı arayüzde çevrilir.
  name        String?
  permissions String[]
  isSystem    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  memberships  Membership[]
  invitations  Invitation[]
  spaceMembers SpaceMember[]

  @@unique([workspaceId, scope, key])
  @@map("roles")
}

model Membership {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  /// Guest daveti için paylaşılan Space'ler (ADR-035, ADR-043).
  spaceIds    String[]  @db.Uuid
  tokenHash   String    @unique
  invitedById String    @db.Uuid
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime  @db.Timestamptz
  acceptedAt  DateTime? @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workspaceId, email])
  @@map("invitations")
}

/// Append-only değişiklik kaydı (ADR-015): aktivite akışı, denetim, raporlar.
model ActivityEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = sistem işlemi.
  actorId     String?   @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType  String
  entityId    String    @db.Uuid
  action      String
  /// Alan bazlı değişiklikler: { alan: { from, to } } veya işleme özel veri.
  changes     Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

// ---------- Space / Folder / List (Faz 1.2) ----------
// rank: kesirli sıralama anahtarı (ADR-014), migration'da COLLATE "C" (bayt sırası).
// archivedAt: arşiv; deletedAt: çöp kutusu, 30 gün sonra kalıcı silinir (ADR-041).

model Space {
  id                 String          @id @default(uuid(7)) @db.Uuid
  workspaceId        String          @db.Uuid
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  /// Güncel anahtar; kullanılmış tüm anahtarlar space_keys'te rezerve (ADR-033, ADR-043).
  key                String
  color              String
  icon               String?
  description        String?
  isPrivate          Boolean         @default(false)
  scrumEnabled       Boolean         @default(true)
  sprintLengthWeeks  Int             @default(2)
  /// Sprint başlatmak için hedef zorunlu mu (ADR-060); kapalıysa yalnızca uyarı.
  sprintGoalRequired Boolean         @default(true)
  /// Definition of Done / Ready maddeleri (brief §6.3, ADR-065).
  dodItems           String[]        @default([])
  dorItems           String[]        @default([])
  /// Açıkken eksik DoD ile Done'a geçilemez; kapalıyken yalnızca uyarı.
  dodEnforced        Boolean         @default(false)
  estimationScale    EstimationScale @default(FIBONACCI)
  rank               String
  /// Okunabilir ID sayacı (ADR-044); öğe oluşturulurken atomik artırılır.
  itemCounter        Int             @default(0)
  archivedAt         DateTime?       @db.Timestamptz
  deletedAt          DateTime?       @db.Timestamptz
  deletedById        String?         @db.Uuid
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz
  updatedAt          DateTime        @updatedAt @db.Timestamptz

  keys     SpaceKey[]
  members  SpaceMember[]
  statuses Status[]
  folders  Folder[]
  lists    List[]
  items    WorkItem[]
  labels   Label[]
  sprints  Sprint[]

  @@index([workspaceId])
  @@map("spaces")
}

/// Workspace içinde kullanılmış her Space anahtarı; Space silinse de rezerve kalır.
model SpaceKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String?   @db.Uuid
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  key         String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([workspaceId, key])
  @@map("space_keys")
}

/// Space üyeliği + Scrum rolü (Role.scope = SPACE).
model SpaceMember {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

/// Space durumları (ADR-013, ADR-036). Kurallar kategoriye bakar.
model Status {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String         @db.Uuid
  space       Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  category    StatusCategory
  rank        String
  createdAt   DateTime       @default(now()) @db.Timestamptz

  items WorkItem[]

  @@index([spaceId])
  @@map("statuses")
}

model Folder {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  archivedAt  DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  lists List[]

  @@index([spaceId])
  @@map("folders")
}

model List {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// null = Space kökünde (klasörsüz).
  folderId    String?   @db.Uuid
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  archivedAt  DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  items WorkItem[]

  @@index([spaceId])
  @@index([folderId])
  @@map("lists")
}

/// Kişisel favoriler (Space/Folder/List). entityId türüne göre ilgili tabloya işaret eder.
model Favorite {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FavoriteType
  entityId    String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz

  @@unique([userId, type, entityId])
  @@index([workspaceId, userId])
  @@map("favorites")
}

// ---------- İş öğeleri (Faz 1.3, ADR-044) ----------

model WorkItem {
  id               String       @id @default(uuid(7)) @db.Uuid
  workspaceId      String       @db.Uuid
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId          String       @db.Uuid
  space            Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  listId           String       @db.Uuid
  list             List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Üst öğe aynı Space'tedir; alt ağaç birlikte silinir.
  parentId         String?      @db.Uuid
  parent           WorkItem?    @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children         WorkItem[]   @relation("Tree")
  type             WorkItemType
  /// Okunabilir ID = keyPrefix-number; ömür boyu sabit (ADR-033).
  keyPrefix        String
  number           Int
  title            String
  /// Tiptap belge JSON'u (ADR-048); düz metin karşılığı arama içindir.
  description      Json?
  descriptionText  String?
  statusId         String       @db.Uuid
  status           Status       @relation(fields: [statusId], references: [id])
  priority         Priority     @default(NORMAL)
  reporterId       String?      @db.Uuid
  reporter         User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  startDate        DateTime?    @db.Date
  dueDate          DateTime?    @db.Date
  /// Story Point (Epic/Story/Bug); T-shirt ölçeği sayıya eşlenir (ADR-045).
  points           Float?
  /// Saat tahmini (Task/Sub-task).
  estimateHours    Float?
  completedAt      DateTime?    @db.Timestamptz
  /// List içinde kesirli sıralama anahtarı (ADR-014); migration'da COLLATE "C".
  rank             String
  /// Sprint (yalnızca üst düzey Story/Bug/Task, ADR-061); sprint silinirse boşalır.
  sprintId         String?      @db.Uuid
  sprint           Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Space genelinde öncelik sırası (ADR-062); boşsa ilk okumada atanır, migration'da COLLATE "C".
  backlogRank      String?
  /// İşaretli DoD/DoR madde metinleri (Story/Bug); Space maddesi değişirse işaret kendiliğinden düşer.
  dodChecked       String[]     @default([])
  dorChecked       String[]     @default([])
  // Bug alanları
  severity         BugSeverity?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  environment      String?
  foundInVersion   String?
  // Epic alanları
  goal             String?
  tshirtSize       TshirtSize?
  color            String?
  /// ClickUp içe aktarma (Faz 5).
  externalSource   String?
  externalId       String?
  archivedAt       DateTime?    @db.Timestamptz
  deletedAt        DateTime?    @db.Timestamptz
  deletedById      String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  assignees    WorkItemAssignee[]
  labels       WorkItemLabel[]
  checklists   Checklist[]
  linksFrom    WorkItemLink[]     @relation("LinkFrom")
  linksTo      WorkItemLink[]     @relation("LinkTo")
  watchers     WorkItemWatcher[]
  comments     Comment[]
  attachments  Attachment[]
  sprintEvents SprintItemEvent[]

  @@unique([workspaceId, keyPrefix, number])
  @@index([listId, rank])
  @@index([spaceId, backlogRank])
  @@index([sprintId])
  @@index([spaceId])
  @@index([parentId])
  @@index([statusId])
  @@index([workspaceId, externalSource, externalId])
  @@map("work_items")
}

model WorkItemAssignee {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_assignees")
}

/// Space'e ait etiket.
model Label {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  items WorkItemLabel[]

  @@unique([spaceId, name])
  @@map("labels")
}

model WorkItemLabel {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  labelId     String    @db.Uuid
  label       Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
  @@index([labelId])
  @@map("work_item_labels")
}

// ---------- Görev detayı (Faz 1.4, ADR-049..051) ----------

/// Kabul kriterleri (ACCEPTANCE, öğe başına bir tane) ve adlı checklist'ler.
model Checklist {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String        @db.Uuid
  workItem    WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  kind        ChecklistKind
  title       String
  rank        String
  createdAt   DateTime      @default(now()) @db.Timestamptz

  items ChecklistItem[]

  @@index([workItemId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checklistId String    @db.Uuid
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  rank        String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([checklistId])
  @@map("checklist_items")
}

/// Bağlantı yönü from → to: "from BLOCKS to", "from DUPLICATES to" (ADR-050).
model WorkItemLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromId      String    @db.Uuid
  from        WorkItem  @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String    @db.Uuid
  to          WorkItem  @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  type        LinkType
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([fromId, toId, type])
  @@index([toId])
  @@map("work_item_links")
}

model WorkItemWatcher {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_watchers")
}

// ---------- Yorumlar ve ekler (Faz 1.6, ADR-055, ADR-056) ----------

model Comment {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId    String?   @db.Uuid
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Tiptap belge JSON'u (mention düğümleri dahil).
  body        Json
  bodyText    String
  editedAt    DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  mentions  CommentMention[]
  reactions CommentReaction[]

  @@index([workItemId, createdAt])
  @@map("comments")
}

/// Bildirimler Faz 2'de bu kayıttan beslenir.
model CommentMention {
  commentId   String    @db.Uuid
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentReaction {
  commentId   String    @db.Uuid
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

model Attachment {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  uploaderId  String?   @db.Uuid
  uploader    User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  /// Özgün dosya adı (yalnızca görüntüleme/indirme; diskte rastgele anahtar kullanılır).
  fileName    String
  mimeType    String
  size        Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workItemId])
  @@map("attachments")
}

// ---------- Sprint (Faz 2.1, ADR-061) ----------
// Space başına en çok bir ACTIVE sprint: migration'daki kısmi benzersiz dizin (brief §6.1.1).

model Sprint {
  id              String       @id @default(uuid(7)) @db.Uuid
  workspaceId     String       @db.Uuid
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId         String       @db.Uuid
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name            String
  goal            String?
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  capacityNote    String?
  status          SprintStatus @default(PLANNED)
  startedAt       DateTime?    @db.Timestamptz
  completedAt     DateTime?    @db.Timestamptz
  cancelledAt     DateTime?    @db.Timestamptz
  /// Tamamlanırken donmuş velocity: Done kategorisindeki puan toplamı (brief §6.1.7).
  completedPoints Float?
  /// Sprint Review demo notları (ADR-065); tamamlanmış sprint'te de düzenlenebilir.
  reviewNotes     String?
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz

  items  WorkItem[]
  events SprintItemEvent[]

  @@index([spaceId, status])
  @@map("sprints")
}

/// Sprint üyeliği geçmişi (ADR-061): burndown ve scope change raporlarını besler.
model SprintItemEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprintId    String           @db.Uuid
  sprint      Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  workItemId  String           @db.Uuid
  workItem    WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  action      SprintItemAction
  reason      SprintItemReason
  /// O andaki Story Point (puan sonradan değişse de geçmiş korunur).
  points      Float?
  actorId     String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([sprintId, createdAt])
  @@index([workItemId])
  @@map("sprint_item_events")
}
