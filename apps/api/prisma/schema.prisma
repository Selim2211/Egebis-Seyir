// Veri modeli (ADR-009). Kural: workspace'e ait her model `workspaceId` taşır (ADR-012)
// ve TENANT_MODELS listesine eklenir (src/infra/prisma/tenant-scope.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleScope {
  WORKSPACE
  SPACE
}

enum EstimationScale {
  FIBONACCI
  TSHIRT
  NUMBER
}

enum AutomationOutcome {
  OK
  SKIPPED
  FAILED
}

enum TemplateKind {
  ITEM
  LIST
  SPRINT
  DOC
  SPACE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  MULTI_SELECT
  PERSON
  URL
  CHECKBOX
}

enum StatusCategory {
  NOT_STARTED
  ACTIVE
  DONE
}

enum WorkItemType {
  EPIC
  STORY
  TASK
  SUBTASK
  BUG
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum BugSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TshirtSize {
  S
  M
  L
  XL
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SprintItemAction {
  ADDED
  REMOVED
}

enum SprintItemReason {
  PLANNED
  SCOPE_CHANGE
  CARRIED_OVER
  /// Sprint tamamlanırken/iptal edilirken bitmemiş olarak çıkarıldı.
  UNFINISHED
}

enum ChecklistKind {
  ACCEPTANCE
  CHECKLIST
}

enum LinkType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum FavoriteType {
  SPACE
  FOLDER
  LIST
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// Küçük harfe çevrilmiş e-posta.
  email         String   @unique
  name          String
  /// argon2id, PHC biçimi (ADR-038).
  passwordHash  String
  title         String?
  locale        String   @default("tr")
  theme         String   @default("system")
  timezone      String   @default("Europe/Istanbul")
  /// Profil fotoğrafı sürümü (önbellek anahtarı); null = fotoğraf yok (ADR-059).
  avatarVersion String?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  sessions         Session[]
  memberships      Membership[]
  passwordResets   PasswordResetToken[]
  invitationsSent  Invitation[]         @relation("InvitedBy")
  activities       ActivityEvent[]
  spaceMembers     SpaceMember[]
  favorites        Favorite[]
  reportedItems    WorkItem[]           @relation("Reporter")
  assignedItems    WorkItemAssignee[]
  watchedItems     WorkItemWatcher[]
  comments         Comment[]
  commentMentions  CommentMention[]
  commentReactions CommentReaction[]
  attachments      Attachment[]

  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsCaused     Notification[]           @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  reminders               Reminder[]
  goalsOwned              Goal[]
  conversationsLow        Conversation[]           @relation("ConversationLow")
  conversationsHigh       Conversation[]           @relation("ConversationHigh")
  messagesSent            Message[]
  retroItems              RetroItem[]
  retroVotes              RetroVote[]
  timeEntries             TimeEntry[]
  activeTimer             ActiveTimer?
  dashboardLayouts        DashboardLayout[]
  savedViews              SavedView[]
  docsCreated             Doc[]                    @relation("DocCreator")
  docsUpdated             Doc[]                    @relation("DocUpdater")
  docVersions             DocVersion[]             @relation("DocVersionAuthor")
  templates       Template[]
  apiTokens       ApiToken[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256(token); token yalnızca cookie'de.
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime  @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  roles             Role[]
  memberships       Membership[]
  invitations       Invitation[]
  activities        ActivityEvent[]
  spaces            Space[]
  spaceKeys         SpaceKey[]
  spaceMembers      SpaceMember[]
  statuses          Status[]
  folders           Folder[]
  lists             List[]
  favorites         Favorite[]
  workItems         WorkItem[]
  workItemAssignees WorkItemAssignee[]
  labels            Label[]
  workItemLabels    WorkItemLabel[]
  checklists        Checklist[]
  checklistItems    ChecklistItem[]
  workItemLinks     WorkItemLink[]
  workItemWatchers  WorkItemWatcher[]
  comments          Comment[]
  commentMentions   CommentMention[]
  commentReactions  CommentReaction[]
  attachments       Attachment[]
  sprints           Sprint[]
  sprintItemEvents  SprintItemEvent[]
  sprintSnapshots   SprintSnapshot[]
  docs              Doc[]
  docVersions       DocVersion[]
  retroItems        RetroItem[]
  retroVotes        RetroVote[]
  timeEntries       TimeEntry[]
  activeTimers      ActiveTimer[]
  dashboardLayouts  DashboardLayout[]
  savedViews        SavedView[]
  customFields      CustomField[]
  templates         Template[]
  automations       Automation[]
  forms             Form[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]
  gitIntegrations   GitIntegration[]
  gitLinks          GitLink[]
  automationRuns    AutomationRun[]
  docItemLinks      DocItemLink[]

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  reminders               Reminder[]
  goals                   Goal[]
  conversations           Conversation[]
  messages                Message[]

  @@map("workspaces")
}

/// Rol = izin seti (ADR-011). Sistem rolleri workspace oluşturulurken shared varsayılanlarından kopyalanır.
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope       RoleScope
  /// Sistem rolleri için WORKSPACE_ROLES / SPACE_ROLES anahtarı.
  key         String
  /// Özel roller (F2) için görünen ad; sistem rollerinin adı arayüzde çevrilir.
  name        String?
  permissions String[]
  isSystem    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  memberships  Membership[]
  invitations  Invitation[]
  spaceMembers SpaceMember[]

  @@unique([workspaceId, scope, key])
  @@map("roles")
}

model Membership {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  /// Guest daveti için paylaşılan Space'ler (ADR-035, ADR-043).
  spaceIds    String[]  @db.Uuid
  tokenHash   String    @unique
  invitedById String    @db.Uuid
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime  @db.Timestamptz
  acceptedAt  DateTime? @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workspaceId, email])
  @@map("invitations")
}

/// Append-only değişiklik kaydı (ADR-015): aktivite akışı, denetim, raporlar.
model ActivityEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null = sistem işlemi.
  actorId     String?   @db.Uuid
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType  String
  entityId    String    @db.Uuid
  action      String
  /// Alan bazlı değişiklikler: { alan: { from, to } } veya işleme özel veri.
  changes     Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

// ---------- Space / Folder / List (Faz 1.2) ----------
// rank: kesirli sıralama anahtarı (ADR-014), migration'da COLLATE "C" (bayt sırası).
// archivedAt: arşiv; deletedAt: çöp kutusu, 30 gün sonra kalıcı silinir (ADR-041).

model Space {
  id                 String          @id @default(uuid(7)) @db.Uuid
  workspaceId        String          @db.Uuid
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  /// Güncel anahtar; kullanılmış tüm anahtarlar space_keys'te rezerve (ADR-033, ADR-043).
  key                String
  color              String
  icon               String?
  description        String?
  isPrivate          Boolean         @default(false)
  scrumEnabled       Boolean         @default(true)
  sprintLengthWeeks  Int             @default(2)
  /// Sprint başlatmak için hedef zorunlu mu (ADR-060); kapalıysa yalnızca uyarı.
  sprintGoalRequired Boolean         @default(true)
  /// Definition of Done / Ready maddeleri (brief §6.3, ADR-065).
  dodItems           String[]        @default([])
  dorItems           String[]        @default([])
  /// Açıkken eksik DoD ile Done'a geçilemez; kapalıyken yalnızca uyarı.
  dodEnforced        Boolean         @default(false)
  estimationScale    EstimationScale @default(FIBONACCI)
  rank               String
  /// Okunabilir ID sayacı (ADR-044); öğe oluşturulurken atomik artırılır.
  itemCounter        Int             @default(0)
  archivedAt         DateTime?       @db.Timestamptz
  deletedAt          DateTime?       @db.Timestamptz
  deletedById        String?         @db.Uuid
  createdById        String?         @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz
  updatedAt          DateTime        @updatedAt @db.Timestamptz

  keys             SpaceKey[]
  members          SpaceMember[]
  statuses         Status[]
  customFields     CustomField[]
  templates        Template[]
  automations      Automation[]
  forms            Form[]
  webhooks         Webhook[]
  folders          Folder[]
  lists            List[]
  items            WorkItem[]
  labels           Label[]
  sprints          Sprint[]
  docs             Doc[]
  dashboardLayouts DashboardLayout[]

  notifications Notification[]

  @@index([workspaceId])
  @@map("spaces")
}

/// Workspace içinde kullanılmış her Space anahtarı; Space silinse de rezerve kalır.
model SpaceKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String?   @db.Uuid
  space       Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  key         String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([workspaceId, key])
  @@map("space_keys")
}

/// Space üyeliği + Scrum rolü (Role.scope = SPACE).
model SpaceMember {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

/// Space durumları (ADR-013, ADR-036). Kurallar kategoriye bakar.
model Status {
  id          String         @id @default(uuid(7)) @db.Uuid
  workspaceId String         @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String         @db.Uuid
  space       Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  category    StatusCategory
  rank        String
  /// Board sütunu için en çok iş sayısı (ADR-080); aşılınca uyarır, engellemez.
  wipLimit    Int?           @map("wip_limit")
  /// Silinen durum: işler başka duruma taşınır, kayıt geçmiş raporları için kalır (ADR-081).
  archivedAt  DateTime?      @db.Timestamptz
  createdAt   DateTime       @default(now()) @db.Timestamptz

  items WorkItem[]

  @@index([spaceId])
  @@map("statuses")
}

model Folder {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  archivedAt  DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  lists List[]

  @@index([spaceId])
  @@map("folders")
}

model List {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// null = Space kökünde (klasörsüz).
  folderId    String?   @db.Uuid
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name        String
  rank        String
  archivedAt  DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  deletedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  items      WorkItem[]
  savedViews SavedView[]
  forms      Form[]

  @@index([spaceId])
  @@index([folderId])
  @@map("lists")
}

/// Kişisel favoriler (Space/Folder/List). entityId türüne göre ilgili tabloya işaret eder.
model Favorite {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FavoriteType
  entityId    String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz

  @@unique([userId, type, entityId])
  @@index([workspaceId, userId])
  @@map("favorites")
}

// ---------- İş öğeleri (Faz 1.3, ADR-044) ----------

model WorkItem {
  id               String       @id @default(uuid(7)) @db.Uuid
  workspaceId      String       @db.Uuid
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId          String       @db.Uuid
  space            Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  listId           String       @db.Uuid
  list             List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Üst öğe aynı Space'tedir; alt ağaç birlikte silinir.
  parentId         String?      @db.Uuid
  parent           WorkItem?    @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children         WorkItem[]   @relation("Tree")
  type             WorkItemType
  /// Okunabilir ID = keyPrefix-number; ömür boyu sabit (ADR-033).
  keyPrefix        String
  number           Int
  title            String
  /// Tiptap belge JSON'u (ADR-048); düz metin karşılığı arama içindir.
  description      Json?
  descriptionText  String?
  /// Özel alan değerleri: alan kimliği → değer (ADR-082).
  customFields     Json         @default("{}")
  /// Tekrar kuralı {freq, interval}; tamamlanınca yeni örnek üretilir ve kural ona geçer (Faz 7.1).
  recurrence       Json?
  gitLinks         GitLink[]
  statusId         String       @db.Uuid
  status           Status       @relation(fields: [statusId], references: [id])
  priority         Priority     @default(NORMAL)
  reporterId       String?      @db.Uuid
  reporter         User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  startDate        DateTime?    @db.Date
  dueDate          DateTime?    @db.Date
  /// Story Point (Epic/Story/Bug); T-shirt ölçeği sayıya eşlenir (ADR-045).
  points           Float?
  /// Saat tahmini (Task/Sub-task).
  estimateHours    Float?
  completedAt      DateTime?    @db.Timestamptz
  /// List içinde kesirli sıralama anahtarı (ADR-014); migration'da COLLATE "C".
  rank             String
  /// Sprint (yalnızca üst düzey Story/Bug/Task, ADR-061); sprint silinirse boşalır.
  sprintId         String?      @db.Uuid
  sprint           Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Space genelinde öncelik sırası (ADR-062); boşsa ilk okumada atanır, migration'da COLLATE "C".
  backlogRank      String?
  /// İşaretli DoD/DoR madde metinleri (Story/Bug); Space maddesi değişirse işaret kendiliğinden düşer.
  dodChecked       String[]     @default([])
  dorChecked       String[]     @default([])
  // Bug alanları
  severity         BugSeverity?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  environment      String?
  foundInVersion   String?
  // Epic alanları
  goal             String?
  tshirtSize       TshirtSize?
  color            String?
  /// ClickUp içe aktarma (Faz 5).
  externalSource   String?
  externalId       String?
  archivedAt       DateTime?    @db.Timestamptz
  deletedAt        DateTime?    @db.Timestamptz
  deletedById      String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  assignees    WorkItemAssignee[]
  labels       WorkItemLabel[]
  checklists   Checklist[]
  linksFrom    WorkItemLink[]     @relation("LinkFrom")
  linksTo      WorkItemLink[]     @relation("LinkTo")
  watchers     WorkItemWatcher[]
  comments     Comment[]
  docLinks     DocItemLink[]
  retroTasks   RetroItem[]
  timeEntries  TimeEntry[]
  activeTimers ActiveTimer[]
  attachments  Attachment[]
  sprintEvents SprintItemEvent[]

  notifications Notification[]
  reminders     Reminder[]
  goalLinks     GoalItem[]

  @@unique([workspaceId, keyPrefix, number])
  @@index([listId, rank])
  @@index([spaceId, backlogRank])
  @@index([sprintId])
  @@index([spaceId])
  @@index([parentId])
  @@index([statusId])
  @@index([workspaceId, externalSource, externalId])
  @@map("work_items")
}

model WorkItemAssignee {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_assignees")
}

/// Space'e ait etiket.
model Label {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  items WorkItemLabel[]

  @@unique([spaceId, name])
  @@map("labels")
}

model WorkItemLabel {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  labelId     String    @db.Uuid
  label       Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
  @@index([labelId])
  @@map("work_item_labels")
}

// ---------- Görev detayı (Faz 1.4, ADR-049..051) ----------

/// Kabul kriterleri (ACCEPTANCE, öğe başına bir tane) ve adlı checklist'ler.
model Checklist {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String        @db.Uuid
  workItem    WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  kind        ChecklistKind
  title       String
  rank        String
  createdAt   DateTime      @default(now()) @db.Timestamptz

  items ChecklistItem[]

  @@index([workItemId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checklistId String    @db.Uuid
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  rank        String
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([checklistId])
  @@map("checklist_items")
}

/// Bağlantı yönü from → to: "from BLOCKS to", "from DUPLICATES to" (ADR-050).
model WorkItemLink {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromId      String    @db.Uuid
  from        WorkItem  @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String    @db.Uuid
  to          WorkItem  @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  type        LinkType
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([fromId, toId, type])
  @@index([toId])
  @@map("work_item_links")
}

model WorkItemWatcher {
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([workItemId, userId])
  @@index([userId])
  @@map("work_item_watchers")
}

// ---------- Yorumlar ve ekler (Faz 1.6, ADR-055, ADR-056) ----------

model Comment {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Yorum ya görevin ya da doküman sayfasının (CHECK: tam biri dolu).
  workItemId  String?   @db.Uuid
  workItem    WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  docId       String?   @db.Uuid
  doc         Doc?      @relation(fields: [docId], references: [id], onDelete: Cascade)
  authorId    String?   @db.Uuid
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Tiptap belge JSON'u (mention düğümleri dahil).
  body        Json
  bodyText    String
  editedAt    DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  mentions  CommentMention[]
  reactions CommentReaction[]

  @@index([workItemId, createdAt])
  @@index([docId, createdAt])
  @@map("comments")
}

/// Bildirimler Faz 2'de bu kayıttan beslenir.
model CommentMention {
  commentId   String    @db.Uuid
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentReaction {
  commentId   String    @db.Uuid
  comment     Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

model Attachment {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Ek ya bir görevin ya da bir doküman sayfasının (CHECK: tam biri dolu).
  workItemId  String?   @db.Uuid
  workItem    WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  docId       String?   @db.Uuid
  doc         Doc?      @relation(fields: [docId], references: [id], onDelete: Cascade)
  uploaderId  String?   @db.Uuid
  uploader    User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  /// Özgün dosya adı (yalnızca görüntüleme/indirme; diskte rastgele anahtar kullanılır).
  fileName    String
  mimeType    String
  size        Int
  storageKey  String    @unique
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([workItemId])
  @@index([docId])
  @@map("attachments")
}

// ---------- Sprint (Faz 2.1, ADR-061) ----------
// Space başına en çok bir ACTIVE sprint: migration'daki kısmi benzersiz dizin (brief §6.1.1).

model Sprint {
  id              String       @id @default(uuid(7)) @db.Uuid
  workspaceId     String       @db.Uuid
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId         String       @db.Uuid
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name            String
  goal            String?
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  capacityNote    String?
  status          SprintStatus @default(PLANNED)
  startedAt       DateTime?    @db.Timestamptz
  completedAt     DateTime?    @db.Timestamptz
  cancelledAt     DateTime?    @db.Timestamptz
  /// Tamamlanırken donmuş velocity: Done kategorisindeki puan toplamı (brief §6.1.7).
  completedPoints Float?
  /// Başlatılırken taahhüt edilen toplam puan (burndown başlangıcı, velocity karşılaştırması; ADR-067).
  committedPoints Float?
  /// Sprint Review demo notları (ADR-065); tamamlanmış sprint'te de düzenlenebilir.
  reviewNotes     String?
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz

  items     WorkItem[]
  events    SprintItemEvent[]
  snapshots SprintSnapshot[]

  notifications Notification[]
  retroItems    RetroItem[]

  @@index([spaceId, status])
  @@map("sprints")
}

/// Günlük sprint görüntüsü (ADR-067): burndown ve velocity'nin kalıcı kaynağı.
/// Gün başına tek satır; aynı gün yeniden yazılırsa güncellenir.
model SprintSnapshot {
  id              String    @id @default(uuid(7)) @db.Uuid
  workspaceId     String    @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprintId        String    @db.Uuid
  sprint          Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  /// Space saat diliminde yerel gün (date-only).
  date            DateTime  @db.Date
  totalPoints     Float
  donePoints      Float
  remainingPoints Float
  totalItems      Int
  doneItems       Int
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@unique([sprintId, date])
  @@map("sprint_snapshots")
}

/// Sprint üyeliği geçmişi (ADR-061): burndown ve scope change raporlarını besler.
model SprintItemEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprintId    String           @db.Uuid
  sprint      Sprint           @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  workItemId  String           @db.Uuid
  workItem    WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  action      SprintItemAction
  reason      SprintItemReason
  /// O andaki Story Point (puan sonradan değişse de geçmiş korunur).
  points      Float?
  actorId     String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([sprintId, createdAt])
  @@index([workItemId])
  @@map("sprint_item_events")
}

// ---------- Bildirimler (Faz 2.5, ADR-066) ----------

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  STATUS_CHANGED
  SPRINT_STARTED
  SPRINT_COMPLETED
  AUTOMATION
  REMINDER
}

/// Uygulama içi bildirim kutusu; alıcıya özeldir. data: { actorName, itemKey?, itemTitle?, sprintName? } anlık görüntüsü.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String           @db.Uuid
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?          @db.Uuid
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  spaceId     String           @db.Uuid
  space       Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  workItemId  String?          @db.Uuid
  workItem    WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  sprintId    String?          @db.Uuid
  sprint      Sprint?          @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  data        Json
  readAt      DateTime?        @db.Timestamptz
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Kullanıcının tür bazlı kanal tercihleri; satır yoksa ikisi de açıktır.
enum GoalKind {
  TASKS
  NUMBER
}

/// Birebir mesajlaşma (Faz 7.8, ADR-098): iki kullanıcı arasındaki tek konuşma. `userLowId < userHighId`
/// sıralaması aynı çiftin iki ayrı konuşma açmasını engeller.
model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @db.Uuid
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userLowId     String    @db.Uuid
  userLow       User      @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHighId    String    @db.Uuid
  userHigh      User      @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  /// Her tarafın en son okuduğu an; okunmamış sayısı bundan sonrasına bakar.
  lastReadLowAt  DateTime? @db.Timestamptz
  lastReadHighAt DateTime? @db.Timestamptz
  lastMessageAt DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  messages Message[]

  @@unique([workspaceId, userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  workspaceId    String       @db.Uuid
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?      @db.Uuid
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz
  /// Gönderen sildiğinde dolar; içerik arayüze gönderilmez.
  deletedAt      DateTime?    @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Hedef (Faz 7.9, ADR-097): workspace düzeyinde; görev bazlı (bağlı görevlerin ilerlemesi) ya da sayısal.
model Goal {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  color        String    @default("#7C3AED")
  kind         GoalKind
  dueDate      DateTime? @db.Date
  ownerId      String?   @db.Uuid
  owner        User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Yalnızca NUMBER: başlangıç, güncel ve hedef değer.
  startValue   Float?
  currentValue Float?
  targetValue  Float?
  unit         String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  items GoalItem[]

  @@index([workspaceId])
  @@map("goals")
}

model GoalItem {
  goalId      String   @db.Uuid
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  workItemId  String   @db.Uuid
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  workspaceId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@id([goalId, workItemId])
  @@index([workItemId])
  @@map("goal_items")
}

/// Kişisel görev hatırlatıcısı (Faz 7.3): zamanı gelince bildirim ve e-posta üretilir.
model Reminder {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  remindAt    DateTime  @db.Timestamptz
  note        String?
  /// Gönderildiğinde dolar; gönderilenler listede kalır, kullanıcı silebilir.
  sentAt      DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([sentAt, remindAt])
  @@index([workItemId, userId])
  @@map("reminders")
}

model NotificationPreference {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  inApp       Boolean          @default(true)
  email       Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---------- Dokümanlar (Faz 3.2, ADR-069) ----------

/// Space içi doküman sayfası; sayfa ağacı `parentId` ile kurulur. Silme çöp kutusuna taşır (deletedAt).
model Doc {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId    String?   @db.Uuid
  parent      Doc?      @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Doc[]     @relation("DocTree")
  title       String
  /// Tiptap belge JSON'u (ADR-048); boş sayfa null.
  content     Json?
  /// Aramada kullanılacak düz metin (`richTextToPlain`).
  plainText   String    @default("")
  /// Kardeşler arası sıra (COLLATE "C", migration'da).
  rank        String
  /// Her kayıtta artar; eşzamanlılık denetimi (ADR-069).
  revision    Int       @default(1)
  createdById String?   @db.Uuid
  createdBy   User?     @relation("DocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?   @db.Uuid
  updatedBy   User?     @relation("DocUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  versions DocVersion[]
  comments    Comment[]
  links       DocItemLink[]
  attachments Attachment[]

  @@index([spaceId, parentId])
  @@index([spaceId, deletedAt])
  @@map("docs")
}

/// Sayfa sürümü: aynı yazarın art arda kayıtları tek sürümde birleşir (ADR-069).
model DocVersion {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docId       String    @db.Uuid
  doc         Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  content     Json?
  authorId    String?   @db.Uuid
  author      User?     @relation("DocVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@unique([docId, version])
  @@map("doc_versions")
}

/// Doküman sayfası ↔ iş öğesi bağlantısı (ADR-070).
model DocItemLink {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docId       String    @db.Uuid
  doc         Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@id([docId, workItemId])
  @@index([workItemId])
  @@map("doc_item_links")
}

// ---------- Retrospektif (Faz 3.4, ADR-071) ----------

enum RetroColumn {
  WENT_WELL
  IMPROVE
  ACTION
}

/// Sprint retrospektifindeki bir madde; ACTION maddesi göreve çevrilebilir.
model RetroItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprintId    String      @db.Uuid
  sprint      Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  column      RetroColumn
  text        String
  authorId    String?     @db.Uuid
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Aksiyondan oluşturulan görev; görev silinirse bağ kopar.
  taskId      String?     @db.Uuid
  task        WorkItem?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @db.Timestamptz

  votes RetroVote[]

  @@index([sprintId, createdAt])
  @@map("retro_items")
}

model RetroVote {
  retroItemId String    @db.Uuid
  retroItem   RetroItem @relation(fields: [retroItemId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([retroItemId, userId])
  @@map("retro_votes")
}

// ---------- Zaman takibi (Faz 4.3, ADR-075) ----------

enum TimeSource {
  MANUAL
  TIMER
}

/// Bir kişinin bir güne girdiği süre (dakika). Gün, kayıt anındaki İstanbul gününe göre.
model TimeEntry {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @db.Uuid
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String     @db.Uuid
  workItem    WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId      String?    @db.Uuid
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  day         DateTime   @db.Date
  minutes     Int
  note        String?
  source      TimeSource
  createdAt   DateTime   @default(now()) @db.Timestamptz

  @@index([workItemId])
  @@index([userId, day])
  @@map("time_entries")
}

/// Çalışan sayaç: kullanıcı başına en çok bir tane (userId birincil anahtar).
model ActiveTimer {
  userId      String    @id @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String    @db.Uuid
  workItem    WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now()) @db.Timestamptz

  @@map("active_timers")
}

// ---------- Pano (Faz 4.6, ADR-078) ----------

/// Kullanıcının bir Space için pano düzeni (widget sırası, boyutu, görünürlüğü).
model DashboardLayout {
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widgets     Json
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@id([userId, spaceId])
  @@map("dashboard_layouts")
}

// ---------- Kayıtlı görünümler (Faz 5.1, ADR-079) ----------

/// Bir List'in kaydedilmiş süzgeç/sıralama/gruplama/görünüm ayarı; kişisel ya da paylaşımlı.
model SavedView {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listId      String    @db.Uuid
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Sahip silinirse paylaşımlı görünüm kalır.
  ownerId     String?   @db.Uuid
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  shared      Boolean   @default(false)
  config      Json
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  @@unique([listId, ownerId, name])
  @@index([listId])
  @@map("saved_views")
}

/// Space düzeyinde özel alan tanımı (brief §5.8, ADR-082). Değerler iş öğesinde `customFields` JSON'unda.
model CustomField {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @db.Uuid
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String          @db.Uuid
  space       Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  type        CustomFieldType
  /// Liste alanları için seçenekler: [{ id, label, color }].
  options     Json            @default("[]")
  rank        String
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz

  @@index([spaceId])
  @@map("custom_fields")
}

/// Şablon (brief §5.8, ADR-083). `spaceId` boşsa Space şablonudur (workspace geneli). Yük sunucuda üretilir.
model Template {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String?      @db.Uuid
  space       Space?       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind        TemplateKind
  name        String
  payload     Json
  createdById String?      @db.Uuid
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @db.Timestamptz

  @@index([workspaceId, kind])
  @@index([spaceId])
  @@map("templates")
}

/// Space düzeyinde otomasyon kuralı (brief §5.8, ADR-084): tetikleyici + koşullar + eylemler (JSON, sunucuda doğrulanır).
/// Form (Faz 7.4): Space üyelerinin (Stakeholder dahil) belirli bir List'e görev açmasını sağlar.
model Form {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String       @db.Uuid
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  listId      String       @db.Uuid
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  name        String
  description String?
  itemType    WorkItemType @default(TASK)
  /// Başlık dışındaki alanlar: [{key, required}] (shared FormFieldSchema).
  fields      Json         @default("[]")
  enabled     Boolean      @default(true)
  createdById String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  @@index([spaceId])
  @@map("forms")
}

model Automation {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String    @db.Uuid
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean   @default(true)
  trigger     Json
  conditions  Json      @default("{}")
  actions     Json
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  runs AutomationRun[]

  @@index([spaceId])
  @@map("automations")
}

/// Otomasyon çalışma günlüğü; her otomasyon için son 100 kayıt tutulur.
model AutomationRun {
  id           String            @id @default(uuid(7)) @db.Uuid
  workspaceId  String            @db.Uuid
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String            @db.Uuid
  automation   Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  itemKey      String?
  outcome      AutomationOutcome
  message      String?
  createdAt    DateTime          @default(now()) @db.Timestamptz

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

/// Kişisel API erişim token'ı (brief §5.18, ADR-086): kullanıcı adına çalışır; yalnızca SHA-256 özeti saklanır.
model ApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Listede tanımak için token'ın ilk karakterleri (gizli kısım değil).
  prefix     String
  tokenHash  String    @unique
  readOnly   Boolean   @default(false)
  expiresAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
  revokedAt  DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("api_tokens")
}

enum WebhookFormat {
  GENERIC
  SLACK
  TEAMS
}

enum DeliveryStatus {
  PENDING
  OK
  FAILED
}

/// Space'in giden webhook'u (brief §5.18, ADR-087). GENERIC imzalı JSON gönderir; SLACK/TEAMS sohbet mesajı (ADR-088).
model Webhook {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  spaceId     String        @db.Uuid
  space       Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  format      WebhookFormat @default(GENERIC)
  url         String
  /// GENERIC için HMAC anahtarı; yalnızca oluşturmada gösterilir.
  secret      String?
  events      String[]
  enabled     Boolean       @default(true)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz

  deliveries WebhookDelivery[]

  @@index([spaceId])
  @@map("webhooks")
}

/// Teslimat günlüğü; webhook başına son 50 kayıt tutulur.
model WebhookDelivery {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @db.Uuid
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookId      String         @db.Uuid
  webhook        Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  responseStatus Int?
  error          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz
  deliveredAt    DateTime?      @db.Timestamptz

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

enum GitProvider {
  GITHUB
  GITLAB
}

enum GitLinkKind {
  COMMIT
  PULL_REQUEST
}

enum GitLinkState {
  OPEN
  MERGED
  CLOSED
}

/// Gelen Git webhook'u tanımı (brief §5.18, ADR-089): sağlayıcı olayları iş anahtarlarına bağlar.
model GitIntegration {
  id          String      @id @default(uuid(7)) @db.Uuid
  workspaceId String      @db.Uuid
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  provider    GitProvider
  /// GitHub: HMAC-SHA256 anahtarı; GitLab: gizli token. Yalnızca oluşturmada gösterilir.
  secret      String
  enabled     Boolean     @default(true)
  lastEventAt DateTime?   @db.Timestamptz
  createdAt   DateTime    @default(now()) @db.Timestamptz

  @@index([workspaceId])
  @@map("git_integrations")
}

/// İş öğesine bağlı commit veya PR/MR.
model GitLink {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItemId  String       @db.Uuid
  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  provider    GitProvider
  kind        GitLinkKind
  repo        String
  externalId  String
  title       String
  url         String?
  state       GitLinkState?
  author      String?
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  @@unique([workItemId, provider, kind, repo, externalId])
  @@index([workItemId])
  @@map("git_links")
}
