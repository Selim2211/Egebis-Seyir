# Kopyala: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# docker/compose.dev.yml içindeki Postgres (host portu 5433)
DATABASE_URL=postgresql://scrum:scrum@localhost:5433/scrum_dev
# Entegrasyon testleri bu veritabanını kullanır (pnpm test:int)
TEST_DATABASE_URL=postgresql://scrum:scrum@localhost:5433/scrum_test

# Web uygulamasının adresi (e-postadaki bağlantılar)
APP_URL=http://localhost:5173
# İlk kurulum anahtarı; boş bırakılırsa API açılışında loga yazılır
# Giriş/kurulum/sıfırlama uçlarında IP başına dakikalık sınır
AUTH_RATE_LIMIT=10

# E-posta: geliştirmede Mailpit (http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Scrum Manager <no-reply@localhost>"

# Arka plan işleri (pg-boss)
QUEUE_ENABLED=true

# Dosya ekleri ve profil fotoğrafları (Docker'da kalıcı volume)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
