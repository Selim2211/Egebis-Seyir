# Kopyala: cp .env.example .env
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# docker/compose.dev.yml içindeki Postgres (host portu 5433)
DATABASE_URL=postgresql://scrum:scrum@localhost:5433/scrum_dev
# Entegrasyon testleri bu veritabanını kullanır (pnpm test:int)
TEST_DATABASE_URL=postgresql://scrum:scrum@localhost:5433/scrum_test
