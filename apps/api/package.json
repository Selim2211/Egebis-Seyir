    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scrum/shared": "workspace:*",
    "dotenv": "^18.0.5",
    "helmet": "^8.3.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
