# Egebis Seyir — sunucu kurulum ayarları (docker-compose.yml bu dosyayı .env adıyla okur).
# Kopyala:  cp .env.example .env   ve aşağıdaki değerleri doldur.

# ---------- Adres ----------
# Uygulamanın tarayıcıdaki tam adresi (port dahil, ör. http://192.168.1.50:8092). E-postadaki bağlantılar ve webhook adresleri bununla kurulur.
APP_URL=http://localhost:8092
# Caddy'nin dinleyeceği site adresi:
#   - Alan adı (ör. scrum.sirketiniz.com): otomatik Let's Encrypt HTTPS sertifikası alınır
#     (sunucunun 80 ve 443 portları internetten erişilebilir olmalı).
#   - :80  → yalnızca HTTP (HTTPS'i önünüzdeki başka bir vekil/yük dengeleyici sağlıyorsa ya da iç ağ denemesi).
SITE_ADDRESS=:80
# Yalnızca HTTP ile (SITE_ADDRESS=:80 ve önünde HTTPS yoksa) false yapın; yoksa giriş çalışmaz.
COOKIE_SECURE=false
# Sunucuda dışarı açılacak portlar. Varsayılan: uygulama http://<sunucu>:8092 adresinde açılır.
# Alan adı + otomatik HTTPS kullanacaksanız SITE_ADDRESS=alanadi, HTTP_PORT=80, HTTPS_PORT=443 yapın ve COOKIE_SECURE=true yazın.
HTTP_PORT=8092
HTTPS_PORT=8443

# ---------- Veritabanı ----------
POSTGRES_USER=scrum
# Uzun ve rastgele bir şifre koyun (ör. openssl rand -base64 24). Değiştirmeyi unutmayın!
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=scrum

# ---------- E-posta (Gmail: egebisseyir@gmail.com) ----------
# SMTP_PASS = Google "Uygulama şifresi" (16 harf, boşluksuz). Bu dosya git'e girmez; sunucuya ayrıca kopyalanır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 portu (SSL) için true
SMTP_SECURE=false
SMTP_USER=egebisseyir@gmail.com
SMTP_PASS=
MAIL_FROM="Egebis Seyir <egebisseyir@gmail.com>"

# ---------- Yedekleme ----------
# Günlük yedek saati (0-23) ve kaç gün saklanacağı; yedekler sunucuda BACKUP_DIR klasörüne yazılır.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# ---------- İsteğe bağlı ----------
TZ=Europe/Istanbul
LOG_LEVEL=info
# Dosya eki başına en çok MB
MAX_UPLOAD_MB=100
# Video arşivinde video başına en çok MB (parça parça yüklenir; diskte yer ayırın)
MAX_VIDEO_MB=2048
# Giriş/kurulum uçlarında IP başına dakikalık deneme sınırı
AUTH_RATE_LIMIT=10
# Webhook'lar şirket içi (özel ağ) adreslere gidebilsin mi? (ör. iç Mattermost)
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Yapay zekâ önerileri (ADR-090). Boşsa özellik kapalıdır. Doldurulursa iş metinleri Anthropic API'sine gönderilir.
ANTHROPIC_API_KEY=

# Çağrı sistemi (ADR-138): bu kutuya gelen e-postalar otomatik Bug olur (Gelen Çağrılar Projesi, "Belirsiz" listesi).
# HOST, USER ve PASS doluysa açılır; boşsa hiç çalışmaz. İlk açılıştan ÖNCE gelen e-postalar içe alınmaz.
# TICKET_IMAP_HOST=mail.example.com
# TICKET_IMAP_PORT=993
# TICKET_IMAP_SECURE=true
# TICKET_USER=destek@example.com
# TICKET_PASS=
# TICKET_ADDRESS=destek@example.com      # kullanıcı adı adres değilse; otomatik yanıt bu adresten gider
# TICKET_SMTP_HOST=mail.example.com      # boşsa IMAP sunucusu kullanılır
# TICKET_SMTP_PORT=465
# TICKET_SMTP_SECURE=true
# TICKET_FROM_NAME=Egebis Destek
# TICKET_POLL_SECONDS=60
# TICKET_AUTO_REPLY=true                 # müşteriye "talebiniz alındı, kayıt no" yanıtı
# TICKET_AI_ENABLED=false                # yapay zeka ile Proje/önem/özet önerisi (ADR-141)
# TICKET_AI_KEY=                         # OpenAI uyumlu API anahtarı (ya da Ayarlar ekranından, şifreli)
# TICKET_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# TICKET_AI_URL=https://integrate.api.nvidia.com/v1
